# ==============================================================================
# Variables de entorno — Sistema Universitario UCC v2.0
# Copia este archivo a `.env` para desarrollo local con Docker.
# ==============================================================================

# Base de datos PostgreSQL (Docker local por defecto; en producción usa la URL de Supabase)
POSTGRES_USER=ucc_admin
POSTGRES_PASSWORD=ucc_local_dev_2026
POSTGRES_DB=universidad_ucc
DATABASE_URL=postgresql+psycopg://ucc_admin:ucc_local_dev_2026@postgres:5432/universidad_ucc

# Seguridad JWT (en producción genera un secreto largo aleatorio)
JWT_SECRET_KEY=ucc-dev-secret-cambiar-en-produccion-2026-clave-segura
JWT_EXPIRE_MINUTES=480

# Modo Exposición / Simulación Rápida (true en demo académica, false en producción estricta)
DEMO_MODE=true

# Orígenes CORS permitidos (separados por coma; incluye web local, Tauri y Capacitor)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,http://localhost,https://localhost

# Frontend (Vite / Cloudflare Pages)
VITE_API_URL=http://localhost:8000/api/v1
VITE_GITHUB_RELEASES_URL=https://github.com/SlayerCampo/SistemaUniversitarioDeGestion/releases
