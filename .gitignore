# ==============================================================================
# .gitignore — Monorepo Sistema Universitario UCC v2.0
# ==============================================================================
# Python / Backend
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / pnpm / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
.pnpm-store/

# Tauri / Rust / Desktop Build Artifacts (se publican en GitHub Releases)
frontend/src-tauri/target/
frontend/src-tauri/gen/
dist_installer/
*.exe
!frontend/public/descargas/*.exe
*.msi
*.dmg

# Android / Capacitor / Gradle Build Artifacts (se publican en GitHub Releases)
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
*.apk
!frontend/public/descargas/*.apk
*.aab
*.keystore
*.jks

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Temporales OS / IDEs / Excel
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*.xlsx
*.tmp
